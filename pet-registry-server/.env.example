# Copy to .env (and override locally in .env.local, which is gitignored).
# https://symfony.com/doc/current/configuration.html#configuration-based-on-environment-variables

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate your own value, e.g. `php -r 'echo bin2hex(random_bytes(16));'`
APP_SECRET=change-me
###< symfony/framework-bundle ###


###> nelmio/cors-bundle ###
# Regex of browser origins allowed to call the API (the Vue client).
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
